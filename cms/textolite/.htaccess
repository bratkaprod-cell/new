RewriteEngine on
DirectoryIndex textolite.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^.*$ textolite.php?q=$0 [L,NC,QSA]

<FilesMatch "\.(ini|log)$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
deny from all
</IfModule>
</FilesMatch>

RedirectMatch 404 (?i)(^|/)backup/

Options -Indexes
